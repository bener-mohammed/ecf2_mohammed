{% extends 'base.html.twig' %}

{% block title %}Trombinoscope des stagiaires{% endblock %}

{% block body %}
    <main class="container py-4">

        <div class="d-flex justify-content-between align-items-center mb-4">

            <div>
                <h1 class="h2 mb-1">
                    Trombinoscope des stagiaires
                </h1>

                <p class="text-body-secondary mb-0">
                    {{ trainees|length }} stagiaires
                </p>
            </div>

            <div class="d-flex gap-2">
            
                {% if is_granted('ROLE_ADMIN') %}
            
                    <a
                        href="{{ path('app_trainee_index') }}"
                        class="btn btn-outline-secondary"
                    >
                        Gestion des stagiaires
                    </a>
            
                    <a
                        href="{{ path('app_absence_index') }}"
                        class="btn btn-outline-secondary"
                    >
                        Gestion des absences
                    </a>
            
                    <a
                        href="{{ path('app_logout') }}"
                        class="btn btn-outline-danger"
                    >
                        Se déconnecter
                    </a>
            
                {% else %}
            
                    <a
                        href="{{ path('app_login') }}"
                        class="btn btn-outline-success"
                    >
                        Se connecter
                    </a>
            
                {% endif %}
            
                <button
                    class="btn btn-outline-primary"
                    type="button"
                    data-bs-toggle="offcanvas"
                    data-bs-target="#statisticsOffcanvas"
                    aria-controls="statisticsOffcanvas"
                >
                    Voir les statistiques
                </button>
            
            </div>

        </div>


        <div class="row g-4">

            {% for trainee in trainees %}

                <div class="col-12 col-sm-6 col-md-4 col-lg-3">

                    <article class="card h-100 shadow-sm">

                        <div class="card-body text-center">

                            {% if trainee.photoFilename %}

                                <img
                                    src="{{ asset('uploads/trainees/' ~ trainee.photoFilename) }}"
                                    alt="Photo de {{ trainee.firstName }} {{ trainee.lastName }}"
                                    class="rounded-circle mb-3"
                                    width="120"
                                    height="120"
                                    style="object-fit: cover;"
                                >

                            {% else %}

                                <div
                                    class="rounded-circle bg-secondary text-white
                                           d-flex align-items-center justify-content-center
                                           mx-auto mb-3"
                                    style="width: 120px; height: 120px; font-size: 2rem;"
                                >
                                    {{ trainee.firstName|first|upper }}
                                    {{ trainee.lastName|first|upper }}
                                </div>

                            {% endif %}


                            <h2
                                class="h5 card-title mb-1
                                    {% if is_granted('ROLE_ADMIN')
                                        and (unexcusedCounts[trainee.id] ?? 0) > 5
                                    %}
                                        text-danger fw-bold
                                    {% endif %}
                                "
                            >
                                {{ trainee.firstName }}
                                {{ trainee.lastName }}
                            </h2>


                            <p class="text-body-secondary small mb-0">
                                ID AFPA : {{ trainee.afpaId }}
                            </p>


                            {% if is_granted('ROLE_ADMIN') %}

                                <div class="mt-3">
                                    <a
                                        href="{{ path('app_absence_new', {'id': trainee.id}) }}"
                                        class="btn btn-primary btn-sm"
                                    >
                                        Ajouter une absence
                                    </a>
                                </div>

                            {% endif %}

                        </div>

                    </article>

                </div>

            {% else %}

                <div class="col-12">
                    <div class="alert alert-info">
                        Aucun stagiaire trouvé.
                    </div>
                </div>

            {% endfor %}

        </div>

    </main>


    <div
        class="offcanvas offcanvas-end"
        tabindex="-1"
        id="statisticsOffcanvas"
        aria-labelledby="statisticsOffcanvasLabel"
    >

        <div class="offcanvas-header">

            <h2
                class="offcanvas-title h5"
                id="statisticsOffcanvasLabel"
            >
                Statistiques des absences
            </h2>

            <button
                type="button"
                class="btn-close"
                data-bs-dismiss="offcanvas"
                aria-label="Fermer"
            ></button>

        </div>


        <div class="offcanvas-body">

            <p class="text-body-secondary small">
                Classement selon le nombre total de jours d'absence.
            </p>


            {% if statistics is not empty %}

                <div class="table-responsive">

                    <table class="table table-sm align-middle">

                        <thead>
                            <tr>
                                <th>Stagiaire</th>
                                <th class="text-center">
                                    Abs.
                                </th>
                                <th class="text-end">
                                    Perte
                                </th>
                            </tr>
                        </thead>

                        <tbody>

                            {% for statistic in statistics %}

                                <tr>

                                    <td>
                                        <span
                                            {% if statistic.unexcusedAbsences > 5 %}
                                                class="text-danger fw-bold"
                                            {% endif %}
                                        >
                                            {{ statistic.firstName }}
                                            {{ statistic.lastName }}
                                        </span>

                                        {% if statistic.unexcusedAbsences > 5 %}
                                            <div class="small text-danger">
                                                {{ statistic.unexcusedAbsences }}
                                                sans motif
                                            </div>
                                        {% endif %}
                                    </td>

                                    <td class="text-center">
                                        {{ statistic.totalAbsences }}
                                    </td>

                                    <td class="text-end">
                                        {{ statistic.lostIncome
                                            |number_format(2, ',', ' ')
                                        }}
                                        €
                                    </td>

                                </tr>

                            {% endfor %}

                        </tbody>

                    </table>

                </div>

            {% else %}

                <div class="alert alert-info">
                    Aucune statistique disponible.
                </div>

            {% endif %}

            <hr>

            <p class="small text-body-secondary mb-0">
                Estimation basée sur 712 € par mois
                pour 21 jours ouvrés.
            </p>

        </div>

    </div>

{% endblock %}