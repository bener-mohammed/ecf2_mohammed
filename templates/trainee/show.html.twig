{% extends 'base.html.twig' %}

{% block title %}Trainee{% endblock %}

{% block body %}
    <h1>Trainee</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ trainee.id }}</td>
            </tr>
            <tr>
                <th>AfpaId</th>
                <td>{{ trainee.afpaId }}</td>
            </tr>
            <tr>
                <th>FirstName</th>
                <td>{{ trainee.firstName }}</td>
            </tr>
            <tr>
                <th>LastName</th>
                <td>{{ trainee.lastName }}</td>
            </tr>
            <tr>
                <th>Email</th>
                <td>{{ trainee.email }}</td>
            </tr>
            <tr>
                <th>Phone</th>
                <td>{{ trainee.phone }}</td>
            </tr>
            <tr>
                <th>Residence</th>
                <td>{{ trainee.residence }}</td>
            </tr>
            <tr>
                <th>BirthDate</th>
                <td>{{ trainee.birthDate ? trainee.birthDate|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>PhotoFilename</th>
                <td>{{ trainee.photoFilename }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_trainee_index') }}">back to list</a>

    <a href="{{ path('app_trainee_edit', {'id': trainee.id}) }}">edit</a>

    {{ include('trainee/_delete_form.html.twig') }}
{% endblock %}
