{% extends 'base.html.twig' %}

{% block title %}Gestion des stagiaires{% endblock %}

{% block body %}
    <main class="container py-4">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="h2 mb-1">
                    Gestion des stagiaires
                </h1>

                <p class="text-body-secondary mb-0">
                    {{ trainees|length }} stagiaire(s) enregistré(s)
                </p>
            </div>

            <a
                href="{{ path('app_trainee_new') }}"
                class="btn btn-primary"
            >
                Ajouter un stagiaire
            </a>
        </div>

        {% if trainees is not empty %}

            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">

                    <thead class="table-dark">
                        <tr>
                            <th>Photo</th>
                            <th>Identifiant AFPA</th>
                            <th>Stagiaire</th>
                            <th>Email</th>
                            <th>Téléphone</th>
                            <th>Résidence</th>
                            <th>Date de naissance</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        {% for trainee in trainees %}
                            <tr>

                                <td>
                                    {% if trainee.photoFilename %}
                                        <img
                                            src="{{ asset('uploads/trainees/' ~ trainee.photoFilename) }}"
                                            alt="Photo de {{ trainee.firstName }} {{ trainee.lastName }}"
                                            class="rounded-circle"
                                            width="50"
                                            height="50"
                                            style="object-fit: cover;"
                                        >
                                    {% else %}
                                        <div
                                            class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center"
                                            style="width: 50px; height: 50px;"
                                        >
                                            {{ trainee.firstName|first|upper }}
                                            {{ trainee.lastName|first|upper }}
                                        </div>
                                    {% endif %}
                                </td>

                                <td>
                                    {{ trainee.afpaId }}
                                </td>

                                <td>
                                    <strong>
                                        {{ trainee.firstName }}
                                        {{ trainee.lastName }}
                                    </strong>
                                </td>

                                <td>
                                    {{ trainee.email }}
                                </td>

                                <td>
                                    {{ trainee.phone }}
                                </td>

                                <td>
                                    {{ trainee.residence ?: 'Non renseignée' }}
                                </td>

                                <td>
                                    {{ trainee.birthDate
                                        ? trainee.birthDate|date('d/m/Y')
                                        : ''
                                    }}
                                </td>

                                <td>
                                    <a
                                        href="{{ path('app_trainee_edit', {'id': trainee.id}) }}"
                                        class="btn btn-sm btn-warning"
                                    >
                                        Modifier
                                    </a>

                                    <form
                                        method="post"
                                        action="{{ path('app_trainee_delete', {'id': trainee.id}) }}"
                                        class="d-inline"
                                        onsubmit="return confirm('Voulez-vous vraiment supprimer ce stagiaire ?');"
                                    >
                                        <input
                                            type="hidden"
                                            name="_token"
                                            value="{{ csrf_token('delete' ~ trainee.id) }}"
                                        >

                                        <button
                                            type="submit"
                                            class="btn btn-sm btn-danger"
                                        >
                                            Supprimer
                                        </button>
                                    </form>
                                </td>

                            </tr>
                        {% endfor %}
                    </tbody>

                </table>
            </div>

        {% else %}

            <div class="alert alert-info">
                Aucun stagiaire enregistré.
            </div>

        {% endif %}

        <a
            href="{{ path('app_home') }}"
            class="btn btn-outline-secondary mt-3"
        >
            Retour au trombinoscope
        </a>

    </main>
{% endblock %}