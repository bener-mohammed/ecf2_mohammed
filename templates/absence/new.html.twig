{% extends 'base.html.twig' %}

{% block title %}Ajouter une absence{% endblock %}

{% block body %}
    <main class="container py-4">

        <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-6">

                <div class="card shadow-sm">
                    <div class="card-body p-4">

                        <h1 class="h3 mb-3">
                            Ajouter une absence
                        </h1>

                        <p class="text-body-secondary mb-4">
                            Stagiaire :
                            <strong>
                                {{ trainee.firstName }} {{ trainee.lastName }}
                            </strong>
                        </p>

                        {{ form_start(form) }}

                            {{ form_errors(form) }}

                            <div class="mb-3">
                                {{ form_label(form.absenceDate) }}
                                {{ form_widget(form.absenceDate, {
                                    'attr': {
                                        'class': 'form-control'
                                    }
                                }) }}
                                {{ form_errors(form.absenceDate) }}
                            </div>

                            <div class="mb-3">
                                {{ form_label(form.reason) }}
                                {{ form_widget(form.reason, {
                                    'attr': {
                                        'class': 'form-select'
                                    }
                                }) }}
                                {{ form_errors(form.reason) }}
                            </div>

                            <div class="mb-4">
                                {{ form_label(form.proofFile) }}
                                {{ form_widget(form.proofFile, {
                                    'attr': {
                                        'class': 'form-control'
                                    }
                                }) }}
                                {{ form_errors(form.proofFile) }}

                                <div class="form-text">
                                    Facultatif — fichier PDF, 5 Mo maximum.
                                </div>
                            </div>

                            <div class="d-flex gap-2">
                                <button
                                    type="submit"
                                    class="btn btn-primary"
                                >
                                    Enregistrer l'absence
                                </button>

                                <a
                                    href="{{ path('app_home') }}"
                                    class="btn btn-outline-secondary"
                                >
                                    Annuler
                                </a>
                            </div>

                        {{ form_end(form) }}

                    </div>
                </div>

            </div>
        </div>

    </main>
{% endblock %}